{
  "name": "rifa-discord-bot",
  "version": "1.1.7",
  "private": false,
  "description": "Bot de rifas para Discord com Supabase/PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first --import tsx/esm --watch src/index.ts",
    "start": "node --dns-result-order=ipv4first --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "deploy:commands": "node --dns-result-order=ipv4first --import tsx/esm src/deploy-commands.ts",
    "reset:commands": "node --dns-result-order=ipv4first --import tsx/esm src/reset-commands.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node tools/self-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "discord.js": "14.27.0",
    "dotenv": "^16.0.0",
    "zod": "^3.0.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
